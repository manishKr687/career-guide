target/
*.class
.idea/
*.iml
.vscode/
.DS_Store

# Real admin credentials/secret go here (docker compose loads this
# automatically) -- never commit them. See "Admin panel" in README.md.
.env

# Database backups (see scripts/backup-db.* and README.md "Backups") — these
# contain real data and can get large, so they aren't committed.
backups/*.sql
backups/*.tar.gz
!backups/.gitkeep

# Binary dumps from scripts/backup-db.* -- same reasoning as the .sql/.tar.gz
# entries above: real data, and they go stale.
backups/*.dump
