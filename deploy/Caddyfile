# Caddy in front of the API on the Lightsail server. Installed on the host
# (not in Docker) and copied to /etc/caddy/Caddyfile -- see DEPLOYMENT.md,
# "Phase 2 -- AWS Lightsail".
#
# Replace api.yourdomain.com with the real hostname. Caddy obtains and renews
# the HTTPS certificate for it by itself, once DNS points here and ports 80
# and 443 are open.

api.yourdomain.com {
	encode zstd gzip

	# Only what the site needs is public: the API and the health check.
	# Swagger UI and /v3/api-docs list every admin endpoint and stay on the
	# server; reach them over an SSH tunnel to 127.0.0.1:8081 if needed.
	@public path /api/* /actuator/health
	handle @public {
		# The API is published on loopback only (docker-compose.yml), so this
		# is the one way in from outside.
		#
		# Deliberately no trusted_proxies here. Without it Caddy discards any
		# X-Forwarded-For the client sends and sets it to the real client
		# address, which is what AuthRateLimitInterceptor keys its per-IP
		# limits on. Trusting incoming headers would let a caller pick their
		# own rate-limit bucket.
		reverse_proxy 127.0.0.1:8081
	}
	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
